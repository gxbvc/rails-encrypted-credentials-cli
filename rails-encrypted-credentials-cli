#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "optparse"
require "yaml"
require "pathname"
require "fileutils"
require "active_support"
require "active_support/encrypted_configuration"
require "active_support/core_ext/object/deep_dup"

MASK_CHAR = "\u2022" # •
MIN_PREVIEWABLE_LEN = 12
PREVIEW_CHARS = 4

def emit_ok(data, pretty: false)
  payload = { ok: true, data: data }
  puts pretty ? JSON.pretty_generate(payload) : JSON.generate(payload)
  exit 0
end

def emit_err(message, code: "ERROR", pretty: false)
  payload = { ok: false, error: message, code: code }
  warn pretty ? JSON.pretty_generate(payload) : JSON.generate(payload)
  exit 1
end

def resolve_paths(project, env)
  project = Pathname.new(File.expand_path(project))
  unless project.directory?
    emit_err("project directory not found: #{project}", code: "PROJECT_NOT_FOUND")
  end

  if env.nil?
    {
      project: project,
      env: nil,
      content_path: project.join("config/credentials.yml.enc"),
      key_path: project.join("config/master.key"),
      env_key: "RAILS_MASTER_KEY"
    }
  else
    {
      project: project,
      env: env,
      content_path: project.join("config/credentials/#{env}.yml.enc"),
      key_path: project.join("config/credentials/#{env}.key"),
      env_key: "RAILS_MASTER_KEY"
    }
  end
end

def load_config(paths, require_existing: true)
  if require_existing && !paths[:content_path].exist?
    emit_err(
      "credentials file not found: #{paths[:content_path]}",
      code: "CREDENTIALS_FILE_NOT_FOUND"
    )
  end

  unless paths[:key_path].exist? || ENV[paths[:env_key]]
    emit_err(
      "no key found at #{paths[:key_path]} and #{paths[:env_key]} not set",
      code: "KEY_NOT_FOUND"
    )
  end

  ActiveSupport::EncryptedConfiguration.new(
    config_path: paths[:content_path].to_s,
    key_path: paths[:key_path].to_s,
    env_key: paths[:env_key],
    raise_if_missing_key: true
  )
rescue ActiveSupport::EncryptedFile::MissingKeyError => e
  emit_err(e.message, code: "KEY_NOT_FOUND")
rescue ActiveSupport::MessageEncryptor::InvalidMessage
  emit_err("could not decrypt #{paths[:content_path]} — wrong key?", code: "DECRYPT_FAILED")
end

def deep_get(hash, path_parts)
  current = hash
  path_parts.each do |part|
    key_sym = part.to_sym
    key_str = part.to_s
    if current.is_a?(Hash) && current.key?(key_sym)
      current = current[key_sym]
    elsif current.is_a?(Hash) && current.key?(key_str)
      current = current[key_str]
    else
      return :__missing__
    end
  end
  current
end

def deep_set(hash, path_parts, value)
  current = hash
  path_parts[0..-2].each do |part|
    key_sym = part.to_sym
    key_str = part.to_s
    next_val =
      if current.is_a?(Hash) && current.key?(key_sym)
        current[key_sym]
      elsif current.is_a?(Hash) && current.key?(key_str)
        current[key_str]
      end

    if next_val.is_a?(Hash)
      current = next_val
    else
      new_hash = {}
      current[key_sym] = new_hash
      current = new_hash
    end
  end
  current[path_parts.last.to_sym] = value
  hash
end

def deep_unset(hash, path_parts)
  current = hash
  path_parts[0..-2].each do |part|
    key_sym = part.to_sym
    key_str = part.to_s
    if current.is_a?(Hash) && current.key?(key_sym)
      current = current[key_sym]
    elsif current.is_a?(Hash) && current.key?(key_str)
      current = current[key_str]
    else
      return false
    end
  end
  last = path_parts.last
  if current.is_a?(Hash) && current.key?(last.to_sym)
    current.delete(last.to_sym)
    true
  elsif current.is_a?(Hash) && current.key?(last.to_s)
    current.delete(last.to_s)
    true
  else
    false
  end
end

def mask_string(str)
  s = str.to_s
  len = s.length
  if len < MIN_PREVIEWABLE_LEN
    "#{MASK_CHAR * 6} (len=#{len})"
  else
    "#{s[0, PREVIEW_CHARS]}#{MASK_CHAR * 8}#{s[-PREVIEW_CHARS, PREVIEW_CHARS]} (len=#{len})"
  end
end

def mask_value(value)
  case value
  when Hash
    value.each_with_object({}) { |(k, v), acc| acc[k] = mask_value(v) }
  when Array
    value.map { |v| mask_value(v) }
  when String
    mask_string(value)
  when nil, true, false, Numeric
    "#{MASK_CHAR * 6} (#{value.class.to_s.downcase})"
  else
    mask_string(value.to_s)
  end
end

def stringify_keys_deep(value)
  case value
  when Hash
    value.each_with_object({}) { |(k, v), acc| acc[k.to_s] = stringify_keys_deep(v) }
  when Array
    value.map { |v| stringify_keys_deep(v) }
  else
    value
  end
end

def write_config(paths, hash)
  yaml = stringify_keys_deep(hash).to_yaml
  config = ActiveSupport::EncryptedConfiguration.new(
    config_path: paths[:content_path].to_s,
    key_path: paths[:key_path].to_s,
    env_key: paths[:env_key],
    raise_if_missing_key: true
  )
  config.write(yaml)
end

OPTIONS = {
  project: Dir.pwd,
  env: nil,
  reveal: false,
  pretty: false
}

GLOBAL_OPTS = OptionParser.new do |opts|
  opts.banner = <<~BANNER
    Usage: rails-encrypted-credentials-cli <command> [args] [options]

    Commands:
      get <dotted.path>           Get a value (masked by default)
      set <dotted.path> <value>   Set a string value
      unset <dotted.path>         Remove a key
      dump                        Dump entire credentials tree (masked by default)
      envs                        List available credentials files

    Options:
  BANNER

  opts.on("--project PATH", "Rails project directory (default: cwd)") { |v| OPTIONS[:project] = v }
  opts.on("--env ENV", "Environment (development, production, etc). Omit for default credentials.yml.enc") { |v| OPTIONS[:env] = v }
  opts.on("--reveal", "Show raw values instead of masked previews") { OPTIONS[:reveal] = true }
  opts.on("--pretty", "Pretty-print JSON output") { OPTIONS[:pretty] = true }
  opts.on("-h", "--help", "Show help") { puts opts; exit 0 }
end

argv = ARGV.dup
GLOBAL_OPTS.permute!(argv)
command = argv.shift
emit_err("no command given. Try --help.", code: "NO_COMMAND") if command.nil?

case command
when "get"
  path = argv.shift
  emit_err("usage: get <dotted.path>", code: "BAD_USAGE") if path.nil?

  paths = resolve_paths(OPTIONS[:project], OPTIONS[:env])
  config = load_config(paths)
  hash = config.config

  parts = path.split(".")
  value = deep_get(hash, parts)

  if value == :__missing__
    emit_err("key not found: #{path}", code: "KEY_PATH_NOT_FOUND", pretty: OPTIONS[:pretty])
  end

  out_value = OPTIONS[:reveal] ? value : mask_value(value)
  emit_ok(
    {
      project: paths[:project].to_s,
      env: paths[:env],
      path: path,
      value: out_value,
      revealed: OPTIONS[:reveal]
    },
    pretty: OPTIONS[:pretty]
  )

when "set"
  path = argv.shift
  value = argv.shift
  emit_err("usage: set <dotted.path> <value>", code: "BAD_USAGE") if path.nil? || value.nil?

  paths = resolve_paths(OPTIONS[:project], OPTIONS[:env])
  config = load_config(paths)
  hash = config.config.deep_dup

  parts = path.split(".")
  deep_set(hash, parts, value)
  write_config(paths, hash)

  emit_ok(
    {
      project: paths[:project].to_s,
      env: paths[:env],
      path: path,
      set: true,
      preview: mask_value(value)
    },
    pretty: OPTIONS[:pretty]
  )

when "unset"
  path = argv.shift
  emit_err("usage: unset <dotted.path>", code: "BAD_USAGE") if path.nil?

  paths = resolve_paths(OPTIONS[:project], OPTIONS[:env])
  config = load_config(paths)
  hash = config.config.deep_dup

  parts = path.split(".")
  removed = deep_unset(hash, parts)
  unless removed
    emit_err("key not found: #{path}", code: "KEY_PATH_NOT_FOUND", pretty: OPTIONS[:pretty])
  end
  write_config(paths, hash)

  emit_ok(
    {
      project: paths[:project].to_s,
      env: paths[:env],
      path: path,
      removed: true
    },
    pretty: OPTIONS[:pretty]
  )

when "dump"
  paths = resolve_paths(OPTIONS[:project], OPTIONS[:env])
  config = load_config(paths)
  hash = config.config

  out = OPTIONS[:reveal] ? hash : mask_value(hash)
  emit_ok(
    {
      project: paths[:project].to_s,
      env: paths[:env],
      revealed: OPTIONS[:reveal],
      credentials: stringify_keys_deep(out)
    },
    pretty: OPTIONS[:pretty]
  )

when "envs"
  project = Pathname.new(File.expand_path(OPTIONS[:project]))
  unless project.directory?
    emit_err("project directory not found: #{project}", code: "PROJECT_NOT_FOUND")
  end

  default_path = project.join("config/credentials.yml.enc")
  default_key = project.join("config/master.key")
  env_dir = project.join("config/credentials")

  envs = []
  envs << {
    env: nil,
    content_path: default_path.to_s,
    key_path: default_key.to_s,
    has_content: default_path.exist?,
    has_key: default_key.exist? || !ENV["RAILS_MASTER_KEY"].nil?
  }

  if env_dir.directory?
    env_dir.glob("*.yml.enc").sort.each do |enc|
      env_name = enc.basename.to_s.sub(/\.yml\.enc\z/, "")
      key = env_dir.join("#{env_name}.key")
      envs << {
        env: env_name,
        content_path: enc.to_s,
        key_path: key.to_s,
        has_content: true,
        has_key: key.exist? || !ENV["RAILS_MASTER_KEY"].nil?
      }
    end
  end

  emit_ok(
    {
      project: project.to_s,
      envs: envs
    },
    pretty: OPTIONS[:pretty]
  )

else
  emit_err("unknown command: #{command}. Try --help.", code: "UNKNOWN_COMMAND")
end
